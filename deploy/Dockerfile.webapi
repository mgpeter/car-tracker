# syntax=docker/dockerfile:1
#
# CarTracker WebApi image. Build context is the repo ROOT (the projects reference each other across src/, and
# global.json + Directory.Packages.props live at the root). Example:
#   docker build -f deploy/Dockerfile.webapi -t mgpeter/cartracker-webapi:latest .

# ---- build -----------------------------------------------------------------------------------------------
# Pinned to an exact patch, NOT the floating :10.0 tag. global.json pins the SDK to 10.0.301 with
# rollForward: latestPatch, and roll-forward only ever goes UP — so a build host whose cached :10.0 layer
# predates 10.0.301 fails restore with "A compatible .NET SDK was not found", blaming global.json rather than
# the stale cache. An exact tag is immutable: the cache can never be wrong. Keep this >= global.json's pin
# and in the same feature band (10.0.3xx); bump both together.
FROM mcr.microsoft.com/dotnet/sdk:10.0.302 AS build
WORKDIR /src

# Root build inputs first (central package management + SDK pin) so they cache well.
#
# VERSION and Directory.Build.props are here because the props file reads VERSION into <Version>, and it does
# so at EVALUATION time - so both must be present before `dotnet restore`, not merely before `publish`. Drop
# either and this image silently ships as 1.0.0 while its tag says otherwise, which is what /api/meta used to
# report. Nothing in a working-tree build can see the omission; CI checks the published image instead.
COPY global.json Directory.Packages.props Directory.Build.props VERSION ./

# Only the projects in the WebApi's reference graph (WebApi -> ServiceDefaults, Domain, Data,
# ModelContextProtocol, Chat; Domain -> Data, Shared; Chat -> ModelContextProtocol, Domain, Shared).
#
# This list is hand-maintained, and adding a project without adding it here fails **only in the image build** —
# `dotnet build`, the tests and the contract gate are all green, because they build from the working tree where
# the file is simply there. That is exactly how CarTracker.Chat shipped a red CI: the solution built, every
# suite passed, and the publish job died on "the type or namespace name 'ChatSettings' could not be found".
# If you add a project to the WebApi's graph, add it here in the same commit.
COPY src/CarTracker.Shared/ src/CarTracker.Shared/
COPY src/CarTracker.Data/ src/CarTracker.Data/
COPY src/CarTracker.Domain/ src/CarTracker.Domain/
COPY src/CarTracker.ModelContextProtocol/ src/CarTracker.ModelContextProtocol/
COPY src/CarTracker.Chat/ src/CarTracker.Chat/
COPY src/CarTracker.ServiceDefaults/ src/CarTracker.ServiceDefaults/
COPY src/CarTracker.WebApi/ src/CarTracker.WebApi/

RUN dotnet restore src/CarTracker.WebApi/CarTracker.WebApi.csproj

# OpenApiGenerateDocuments=false: the emitted contract is a build-time codegen artifact for the front end, not
# needed at runtime, and skipping it avoids running the document generator inside the image build.
RUN dotnet publish src/CarTracker.WebApi/CarTracker.WebApi.csproj \
      -c Release -o /app --no-restore -p:OpenApiGenerateDocuments=false

# ---- runtime ---------------------------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
# curl for the compose healthcheck (hits the anonymous /api/meta).
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app ./
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "CarTracker.WebApi.dll"]
