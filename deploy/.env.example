# CarTracker deployment configuration. Copy to `.env` beside docker-compose.yml on the NAS and fill in.
# The real .env is git-ignored — never commit it (it holds the DB password).

# Docker Hub namespace the images are published under (see scripts/release.* and the CI publish job).
DOCKERHUB_USER=mgpeter

# Image tag to run. `latest` lets Watchtower auto-update; pin a version (e.g. 1.3.0) to freeze a deploy.
TAG=latest

# Postgres superuser password. Use a strong value; it is read only on first init of the data directory.
POSTGRES_PASSWORD=change-me

# Where Postgres data and backups live ON THE NAS DISK (bind mounts — survive down -v / rebuild / destroy).
# Create ${DATA_ROOT}/pgdata and ${DATA_ROOT}/backups before the first `up`.
DATA_ROOT=/volume1/docker/cartracker

# Public host port for the gateway. Must match the origin registered in Auth0 (http://synologynas:8082).
GATEWAY_PORT=8082

# Timezone for backup timestamps and Watchtower schedules.
TZ=Europe/London
