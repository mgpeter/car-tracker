# Cambelt deployment configuration.
#
# THERE ARE TWO DEPLOYMENT MODES AND THIS FILE COVERS BOTH. The values below are the STANDALONE defaults (the
# Synology, or any single box); the shared-host column notes what changes on Asgard. See the README's
# deployment section for the full picture.
#
#   Standalone   copy this to `.env` beside docker-compose.yml and fill it in, then
#                  docker compose -f docker-compose.yml -f docker-compose.standalone.yml --profile standalone up -d
#
#   Shared host  DO NOT COPY THIS FILE THERE. The tenant .env is rendered from Azure Key Vault by the host
#                into /srv/infra/tenants/cambelt/.env and passed with --env-file. It must never be committed,
#                and it must never be placed under /srv/data/cambelt/ - that tree is what the host's restic
#                job copies off-box, so a secrets file inside it is a secrets file in the backups.
#
# The real .env is git-ignored either way - never commit it (it holds the DB password).

# Docker Hub namespace the images are published under (see the CI publish and release workflows - since
# DEC-021 they are the only things that push, and scripts/release.* cannot).
DOCKERHUB_USER=mgpeter

# Image tag to run. There are three channels, and they answer different questions.
#
#   stable   the release channel. Moves only when a `v<version>` git tag is pushed, which is a deliberate
#            act taken after a version has proven itself. `latest` is the same digest under the name a bare
#            `docker pull` resolves; prefer `stable`, because the name says what the channel is.
#   edge     the tip of main. Moves on every commit that can affect an image. This is the dogfooding
#            channel: it is what finds the bugs, and it is what the NAS should run.
#   0.22.0   frozen. Nothing moves it, ever, so Watchtower cannot move you either.
#
#   Standalone   `stable` or `edge`, depending on whether this box is the one you break things on.
#   Shared host  PIN AN EXACT VERSION. There is one image per service and it works for any Auth0 tenant, so
#                the tag is the only thing that decides what runs; pinning also means the host's Watchtower
#                will not move you, because a semver tag is immutable. Production then changes when you change
#                this line and at no other time, which is the intent for a public site.
#
# WATCHTOWER FOLLOWS THE TAG THE CONTAINER WAS CREATED FROM, not the one in this file. Changing this line
# needs `docker compose up -d` - Container Manager's *Build* - because a Restart reuses the existing spec.
TAG=stable

# Postgres password.
#
#   Standalone   the superuser password, read only on first init of the data directory.
#   Shared host  the password of the tenant's own `cambelt` role. The role is not a superuser and cannot
#                create databases or install extensions; the host makes the database and the role. The app is
#                tested against PostgreSQL 18 and uses no 18-only feature, so a 17 cluster serves it too -
#                the server version on a shared box is the host's decision, not this repo's.
#
# Deliberately no `:?` guard on this in the compose file, so `docker compose config` works without an .env for
# validation. A blank one is not silent: Postgres refuses the connection and the container fails at boot.
POSTGRES_PASSWORD=change-me

# The database and role to connect as. Blank/absent gives the standalone pair.
#
#   Standalone   leave unset - defaults to cartrackerdb / postgres, exactly as before.
#   Shared host  PGDATABASE=cambelt and PGUSER=cambelt, both created by the host.
#
# `Maximum Pool Size=20` is appended in the compose file and is not optional on a shared server: Npgsql
# defaults to 100 connections PER CONNECTION STRING against a cluster configured for 150 IN TOTAL, so two
# tenants at the default can starve the third.
#PGDATABASE=cambelt
#PGUSER=cambelt

# Where Postgres data, uploaded documents and backups live (bind mounts - they survive down -v, rebuild and
# destroy; only deleting the host folder removes them).
#
#   Standalone   create ${DATA_ROOT}/pgdata18, ${DATA_ROOT}/documents and ${DATA_ROOT}/backups before the
#                first `up`. The documents folder holds the uploaded files themselves and is NOT covered by
#                the db-backup sidecar (which dumps Postgres only), so back it up alongside
#                ${DATA_ROOT}/backups.
#
#                pgdata18, not pgdata: Postgres 18 moved the image's data directory, and a box that predates
#                that still has a PG17 cluster in ${DATA_ROOT}/pgdata. Pointing 18 at the old folder does not
#                fail, it quietly gives you an empty database - see "Major version upgrade" in
#                docs/deployment-synology.md.
#   Shared host  /srv/data/cambelt, and EVERY bind mount must stay under it: that is precisely the tree the
#                host snapshots, and bytes written anywhere else are not backed up with nothing to say so.
DATA_ROOT=/volume1/docker/cartracker

# Public host port for the gateway. STANDALONE ONLY - it is supplied by docker-compose.standalone.yml, and the
# base file publishes no ports at all. On the shared host Caddy is the only listener and a published port is a
# drift-check failure and a real internet exposure, because Docker's DNAT sits in PREROUTING while ufw filters
# INPUT. Must match the origin registered in Auth0 (http://synologynas:8082).
GATEWAY_PORT=8082

# .NET garbage collector. 1 = server GC (a heap per core, faster, hungry), 0 = workstation.
#
#   Standalone   leave unset; it defaults to 1, which is what the NAS has always run.
#   Shared host  0. Server GC reserves per-core heaps and is a real memory hog beside three or four
#                neighbours on an 8 GiB VM.
#
# It is named explicitly in the compose file because --env-file only feeds ${...} interpolation; it does not
# inject anything into a container. Without that line this value would go nowhere.
#DOTNET_gcServer=0

# The Auth0 API (resource server) tokens are validated against, and the tenant that issues them.
#
#   Standalone   leave unset - defaults to cartracker.api on the usualexpat tenant.
#   Shared host  AUTH0_AUDIENCE=cambelt.api
#
# THE AUDIENCE IS A SECURITY BOUNDARY, NOT A LABEL. A bearer token is checked on signature, issuer, audience
# and expiry, and nothing checks which client asked for it - so while two deployments share an audience, a
# token minted against a box on a home LAN is cryptographically valid on the public site.
#
# AUTH0_AUDIENCE is read by BOTH halves: the webapi validates tokens against it, and the gateway hands it to
# the browser so the SPA requests tokens for it. They are two ends of one check and a mismatch is a 401 on
# every request after an apparently successful login.
#AUTH0_AUDIENCE=cambelt.api
#AUTH0_AUTHORITY=https://usualexpat.uk.auth0.com/

# --- The browser's Auth0 application ------------------------------------------------------------------------
# The gateway serves these to the SPA as /config.js and names AUTH0_SPA_DOMAIN in the Content-Security-Policy
# it emits, so the tenant the browser is permitted to call and the tenant it does call come from one place.
#
# THIS IS WHAT MAKES THE APP SELF-HOSTABLE. Until 0.21.0 these were compiled into the JS bundle by Vite, so
# running this against your own Auth0 tenant meant forking the repo and building your own gateway image, and
# the two deployments here needed two images per release.
#
# Blank falls back to this project's own application - the Lookup__* polarity, not the Signup__* one - so an
# existing .env keeps working with nothing added. Set all three to point a deployment at your own tenant:
#AUTH0_SPA_DOMAIN=your-tenant.eu.auth0.com
#AUTH0_SPA_CLIENT_ID=your-spa-application-client-id

# Timezone for backup timestamps and Watchtower schedules. Standalone only in practice - both services that
# read it are behind the standalone profile.
TZ=Europe/London

# --- DVLA/DVSA registration lookup (optional) -------------------------------------------------------------
# Leave every value blank and the add-car lookup answers 503 "not configured" while manual entry works exactly
# as before. Where the credentials come from is in the README Quickstart; the short version:
#   VES  — https://register-for-ves.driver-vehicle-licensing.api.gov.uk/ (manual approval, key by email)
#   MOT  — a separate DVSA registration giving a key plus OAuth client credentials
# VES ALONE IS ENOUGH: it gates the feature and returns make/colour/year/engine/fuel/tax. The four MOT values
# are all-or-nothing and add only the MOT expiry seed, so a lagging DVSA approval blocks nothing.
VES_API_KEY=
MOT_API_KEY=
MOT_TOKEN_URL=
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=

# --- Who may sign up --------------------------------------------------------------------------------------
# EMPTY MEANS CLOSED — the opposite of the block above, ten lines away. A blank `Lookup__*` means that feature
# is OFF and everything else carries on; a blank `Signup__*` means the DOOR IS SHUT and nobody new gets an
# account. Same blank, opposite polarity.
#
# With both blank (as committed) an unrecognised Auth0 login is refused with a 403 "not yet invited" and no
# user row is created. Existing accounts are never affected: this list decides who may join, not who may stay.
#
# THE ADDRESS MUST ALSO BE VERIFIED BY THE TENANT (`email_verified`), and this is not a detail. On a database
# connection anyone can self-register with any address they can type, so a domain here would otherwise admit
# whoever registers as `anything@example.com` — the deployment reads as invitation-only and is open to the
# internet. A connection that never verifies addresses therefore admits nobody, whatever is listed below.
#
# COMMA-SEPARATED, and deliberately not indexed lists (`Signup__AllowedDomains__0=`): an indexed key left empty
# injects an entry of "", an empty entry matches every address alive, and the closed default becomes an open
# door with nothing in this file looking wrong.
SIGNUP_ALLOWED_EMAILS=
SIGNUP_ALLOWED_DOMAINS=

# --- Auth0 Management API ---------------------------------------------------------------------------------
# A machine-to-machine application in the same tenant, authorised for the Management API with the `read:users`
# AND `delete:users` grants. The server needs it because the access token carries no email address — only
# `auth0|68a…` — and the allowlist above is checked against the real address, and against whether the tenant
# has verified it. SO WITH THIS UNSET, NOBODY NEW CAN BE ADMITTED even when the allowlist names them: an
# address that cannot be read is not on any list.
# The same credential erases the Auth0 login when someone deletes their account, so with this unset
# DELETE /api/account answers 503 AND DELETES NOTHING — rather than destroying the data and leaving a working
# sign-in behind, which is the worst of both outcomes and would be silent.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# --- Adopting pre-multi-user vehicles (a one-off retrofit) --------------------------------------------------
# The single Auth0 subject (`auth0|…`, from the Auth0 dashboard) permitted to inherit vehicles that have no
# owner. Blank means no adoption, ever — which is what a fresh deployment wants, and what the retired
# "whoever signs in first claims everything" rule got wrong the moment a stranger could sign in first.
OWNERSHIP_CLAIM_UNOWNED_FOR=

# --- The in-app assistant ----------------------------------------------------------------------------------
# An Anthropic API key from platform.claude.com. Blank means the chat is OFF: /api/chat answers 503 and the app
# renders no chat entry point at all — the same polarity as `Lookup__*` above, not the `Signup__*` one.
CHAT_API_KEY=
# Blank uses the shipped default (claude-sonnet-5). Set to claude-opus-5 to trade cost for accuracy.
CHAT_MODEL=

# The daily token allowances, per account and across the whole deployment. A THIRD POLARITY, and it is worth
# reading twice: BLANK means "use the code default" (1,000,000 and 5,000,000), while an explicit 0 TURNS THE
# CHAT OFF for that scope. So blank is generous and zero is closed — write a number to lower the ceiling.
#
# Every token the model reports counts, cached prefix included, even though a cached one is billed at a tenth.
# The tool catalogue is ~17k of that per turn, so read the per-account figure as roughly 60 turns a day rather
# than as a quantity of conversation. It is a guard rail on volume, not an invoice.
CHAT_DAILY_TOKENS_PER_OWNER=
CHAT_DAILY_TOKENS_GLOBAL=
