# syntax=docker/dockerfile:1
#
# CarTracker Gateway image — the single public origin: serves the built SPA as static files and reverse-proxies
# /api, /scalar, /openapi and /mcp to the webapi. Build context is the repo ROOT. Example:
#   docker build -f deploy/Dockerfile.gateway -t mgpeter/cartracker-gateway:latest .

# ---- SPA build -------------------------------------------------------------------------------------------
# This Node must match `node-version` in .github/workflows/ci.yml, and there is a comment there saying so.
# This stage builds the bundle that actually ships; CI is what proves it. When the two drift, the artefact
# users receive has been produced by a runtime no test ever ran on - and nothing tells you, because neither
# the compiler nor a test can see the pair. They moved apart once already (CI on 22, this on 24).
FROM node:24-alpine AS spa
WORKDIR /spa
# package files first for a cached npm layer.
COPY src/CarTracker.WebApp/package.json src/CarTracker.WebApp/package-lock.json ./
RUN npm ci
COPY src/CarTracker.WebApp/ ./


# `npm run build` = tsc -b && vite build. Uses the committed generated API types, so no backend is needed.
#
# NO BUILD ARGUMENTS, DELIBERATELY. This image is the same for every deployment: the Auth0 application arrives
# at run time from /config.js, which the gateway serves from its own environment, and the CSP naming that
# tenant is a response header rather than a tag baked in here. There was a version of this Dockerfile that
# took ARG VITE_AUTH0_* and it meant publishing a second image per release and made the project impossible to
# self-host - anyone with their own tenant had to fork and build. `redirect_uri` was already computed from
# window.location.origin at run time; now the rest of it is too.
RUN npm run build

# ---- gateway build ---------------------------------------------------------------------------------------
# Exact patch tag, not floating :10.0 — see the same comment in Dockerfile.webapi. Must be >= global.json's
# SDK pin; the two are bumped together.
FROM mcr.microsoft.com/dotnet/sdk:10.0.302 AS build
WORKDIR /src
# VERSION and Directory.Build.props travel with global.json, and must land before `restore` rather than before
# `publish` - see the longer note in Dockerfile.webapi. Omitting them ships an image whose assembly version
# disagrees with its tag.
COPY global.json Directory.Packages.props Directory.Build.props VERSION ./
COPY src/CarTracker.ServiceDefaults/ src/CarTracker.ServiceDefaults/
COPY src/CarTracker.Gateway/ src/CarTracker.Gateway/
RUN dotnet restore src/CarTracker.Gateway/CarTracker.Gateway.csproj
RUN dotnet publish src/CarTracker.Gateway/CarTracker.Gateway.csproj -c Release -o /app --no-restore

# ---- runtime ---------------------------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app ./
# The SPA lands in the framework-default web root, which UseStaticFiles() and MapFallbackToFile("index.html")
# read from. This is the piece nothing in the repo wired before.
COPY --from=spa /spa/dist ./wwwroot
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "CarTracker.Gateway.dll"]
