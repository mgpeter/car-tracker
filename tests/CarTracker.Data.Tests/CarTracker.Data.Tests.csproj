<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CarTracker.Data\CarTracker.Data.csproj" />
    <ProjectReference Include="..\..\src\CarTracker.Domain\CarTracker.Domain.csproj" />
    <!--
      The MCP tools are tested here rather than in a project of their own: what needs asserting about them is
      what they write to a real database (a chat-attributed row is a row, not a mock), and the Postgres fixture
      and TestOwner already live here. This project is "the tests that need a database", which is why it already
      covers the domain services too.
    -->
    <ProjectReference Include="..\..\src\CarTracker.ModelContextProtocol\CarTracker.ModelContextProtocol.csproj" />
  </ItemGroup>

</Project>
